# --- ДомКлик: учётка личного кабинета подрядчика ---
# Логин — номер телефона. У формы на сайте капризная валидация,
# поэтому держим три написания и пробуем по очереди.
DOMCLICK_USER_1="+7XXXXXXXXXX"
DOMCLICK_USER_2="XXXXXXXXXX"
DOMCLICK_USER_3="8XXXXXXXXXX"
DOMCLICK_PASSWORD=""

# --- Разведка ---
# С какой страницы стартует браузер при снятии трафика
DOMCLICK_START_URL="https://homeland-projects.domclick.ru/"

# --- Сервис ---
# Публичный HTTPS-адрес, на который ходит Битрикс24.
PUBLIC_URL="https://service.example.com"
DATA_DIR="/data"

# --- Битрикс24: локальное приложение ---
B24_PORTAL="https://example.bitrix24.ru"
B24_CLIENT_ID=""
B24_CLIENT_SECRET=""

# Код коннектора в открытых линиях: строчные буквы, цифры и подчёркивание,
# точка запрещена. Нужен уникальный префикс, чтобы не столкнуться с чужими
# коннекторами. После регистрации менять нельзя — к нему привязана вся история.
CONNECTOR_ID="yourprefix_domclick"
